diff --git a/tests/classify.test.js b/tests/classify.test.js
new file mode 100644
index 0000000..510bc36
--- /dev/null
+++ b/tests/classify.test.js
@@ -0,0 +1,97 @@
+const test = require("node:test");
+const assert = require("node:assert");
+const { classify } = require("../classify.js");
+
+// Titles marked (real) were seen in FlipRadar's exported scan logs of 2026-10-23.
+const CASES = {
+  device: [
+    "REDMI A7 PRO 4GB RAM 64GB ROM",                                   // (real)
+    "OPPO A5s",                                                         // (real)
+    "Samsung Galaxy Note20 5G\n256GB",                                  // (real)
+    "Sell my iphone 13 pro max 256gb any sim safe to reset working all", // (real)
+    "Infinix Hot 60Pro+ (Curvescreen)\n256gb GamingPhone",              // (real)
+    "Redmi note 15 5g 8+256",                                           // (real)
+    "For Sale Iphone 13 pro 256gb",                                     // (real)
+    "SAMSUNG A54 5G 128GB",                                             // (real)
+    "Sale iPhone xr lcd issue 128GB",                                   // (real) defective but still a device
+    "Redmi 9t",                                                         // (real)
+    "Realme narzo 50A prime",                                           // (real)
+    "Poco X6 Pro 12/512 5G",
+    "Tecno Spark 20 128gb 4G",
+    "Vivo Y27 128GB",
+    "iPhone 13 128gb with charger and box",
+    "iPhone xr",
+    "REDMI A3 128GB NO ISSUES ALL GOODS GAMITON UG DUGAY MA LOWBAT CLEAR CAMERA GAMING PHONE", // (real) "camera" must not make it a camera
+    "fore+sale+iphone7plus+",                                           // (real) URL-style title
+    "SamsungA07",                                                       // (real) no space after brand
+  ],
+  accessory: [
+    "iPhone+charger+and+Infinix+charger+type+C+",                       // (real, 700 pesos)
+    "iPhone 13 case",
+    "Samsung A54 tempered glass",
+    "Phone holder for car",
+    "iPhone 11 lcd replacement original",
+    "Samsung 25W fast charger",
+    "Powerbank 20000mah",
+    "iPhone 12 Pro Max back cover",
+    "Original Samsung battery for Galaxy S9",
+  ],
+  repair: [
+    "B&J IPhone Repair/Center",                                         // (real)
+    "Cellphone repair services",
+    "GADGET REPAIR SHOP Tagbilaran",
+    "iCloud unlock service",
+    "Software flashing and unlocking",
+  ],
+  wanted: [
+    "guba cellphone paliton",                                           // (real) buying broken phones
+    "CELLPHONE GUBA PALITON",                                           // (real)
+    "WTB iPhone 11",
+    "Looking for Samsung A54",
+    "Buying used cellphones any brand",
+    "Binibili namin ang iyong cellphone",
+    "MO PALIT KO GUBA NGA IPHONE",                                      // (real) "I will buy your broken iPhone"
+    "Guba+nga+iphone+x+pataas+paliton+nako+pm+dayon",                   // (real)
+  ],
+  review: [
+    "Cell phone",                                                       // (real)
+    "cellphone",                                                        // (real)
+    "Cellphone+",                                                       // (real)
+    "cellphone gadgets no issue pm sa mupalit",                         // (real) selling cue but no model
+    "iPhone Brandnew & Good as new \u203c\ufe0f",                       // (real) brand only
+  ],
+};
+
+for (const [expected, titles] of Object.entries(CASES)) {
+  for (const title of titles) {
+    test(`${expected}: ${title.replace(/\n/g, " ").slice(0, 55)}`, () => {
+      const r = classify(title, 5000);
+      assert.strictEqual(r.cls, expected, `got ${r.cls} (${r.reason}) kind=${r.kind}`);
+    });
+  }
+}
+
+test("non-phone electronics are not classified as phones", () => {
+  const monitor = classify("SAMSUNG ODYSSEY G5 MONITOR BRANDNEW AND SEALED", 8000);
+  assert.strictEqual(monitor.kind, "other");
+  assert.strictEqual(classify("FROST FREE SAMSUNG REFRIGERATOR", 12000).kind, "other");
+  assert.strictEqual(classify("FOR SALE: RAM DDR5 5600mhz 8GB (SAMSUNG)", 2000).kind, "other");   // (real) RAM stick, not a phone
+  assert.strictEqual(classify("1tb Samsung 9100 pro Nvme", 5000).kind, "other");
+  assert.strictEqual(classify("Samsung Galaxy Tab S3 9.7inch. With SIMCARD", 4000).kind, "tablet");
+  assert.strictEqual(classify("HUAWEI MATEPAD 11.5 PAPERMATTE EDITION 256GB", 9000).kind, "tablet");
+  assert.strictEqual(classify("Xiaomi Redmi Pad 2", 7000).kind, "tablet");
+  assert.strictEqual(classify("Rush Sale need funds\nSamsung Galaxy Watch 6 Classic 47mm", 6000).kind, "wearable");
+  assert.strictEqual(classify("REDMI PAD 2 PRO 5G and iPhone XR", 14000).kind !== "other", true);
+});
+
+test("defect flags are kept on genuine devices", () => {
+  const r = classify("Sale iPhone xr lcd issue 128GB", 2500);
+  assert.strictEqual(r.cls, "device");
+  assert.ok(r.flags.includes("defective"));
+});
+
+test("very low price phone goes to review instead of being discarded", () => {
+  const r = classify("iPhone xr", 300);
+  assert.strictEqual(r.cls, "review");
+  assert.ok(r.flags.includes("very-low-price"));
+});
diff --git a/tests/discovery.test.js b/tests/discovery.test.js
new file mode 100644
index 0000000..81cccb1
--- /dev/null
+++ b/tests/discovery.test.js
@@ -0,0 +1,69 @@
+const test = require("node:test");
+const assert = require("node:assert");
+const D = require("../discovery.js");
+const POOL = ["phone", "cellphone", "android", "128gb", "256gb"];
+const mk = (id, local, device = true) => ({ id, local, device });
+
+test("computeYield credits a listing only to the first keyword that returned it", () => {
+  const y = D.computeYield([
+    { k: "cellphone", raw: 48, listings: [mk(1, true), mk(2, true), mk(3, false)] },
+    { k: "phone",     raw: 48, listings: [mk(2, true), mk(3, false), mk(4, true)] },
+  ]);
+  assert.deepStrictEqual([y[0].unique, y[0].localUnique, y[0].duplicates], [3, 2, 0]);
+  assert.deepStrictEqual([y[1].unique, y[1].localUnique, y[1].duplicates], [1, 1, 2]);
+});
+
+test("computeYield counts devices separately from other local listings", () => {
+  const y = D.computeYield([{ k: "x", raw: 10, listings: [mk(1, true, true), mk(2, true, false), mk(3, true, true)] }]);
+  assert.strictEqual(y[0].localUnique, 3);
+  assert.strictEqual(y[0].deviceLocalUnique, 2);
+});
+
+test("untried terms are explored first, in pool order", () => {
+  assert.deepStrictEqual(D.pickDiscoveryTerms({}, POOL, 3), ["phone", "cellphone", "android"]);
+});
+
+test("after a scan, proven performers outrank untried-last but untried still go first", () => {
+  let h = D.recordScan({}, D.computeYield([
+    { k: "phone", raw: 48, listings: [mk(1, false)] },
+    { k: "cellphone", raw: 48, listings: [mk(2, true), mk(3, true), mk(4, true)] },
+  ]));
+  const picks = D.pickDiscoveryTerms(h, POOL, 3);
+  assert.deepStrictEqual(picks.slice(0, 2), ["android", "128gb"]);   // untried first
+  assert.ok(picks.includes("cellphone") || picks.length === 3);
+  h = D.recordScan(h, D.computeYield([{ k: "android", raw: 1, listings: [] }, { k: "128gb", raw: 1, listings: [] }, { k: "256gb", raw: 1, listings: [] }]));
+  const next = D.pickDiscoveryTerms(h, POOL, 1);
+  assert.deepStrictEqual(next, ["cellphone"]);                       // best devices per run
+});
+
+test("a term with zero local devices over 3 runs rests, then is retried later", () => {
+  let h = {};
+  for (let i = 0; i < 3; i++) h = D.recordScan(h, D.computeYield([{ k: "android", raw: 48, listings: [mk(100 + i, false)] }]));
+  assert.ok(!D.pickDiscoveryTerms(h, ["android", "phone"], 2).includes("android"));
+  for (let i = 0; i < 5; i++) h = D.recordScan(h, D.computeYield([{ k: "phone", raw: 48, listings: [mk(200 + i, true)] }]));
+  assert.ok(D.pickDiscoveryTerms(h, ["android", "phone"], 2).includes("android"), "should be revisited after resting");
+});
+
+test("one scan alone never retires a keyword", () => {
+  const h = D.recordScan({}, D.computeYield([{ k: "256gb", raw: 48, listings: [mk(1, false)] }]));
+  assert.ok(D.pickDiscoveryTerms(h, POOL, 5).includes("256gb"));
+});
+
+test("history is not mutated by recordScan", () => {
+  const h = { __scans: 1, phone: { runs: 1, raw: 1, unique: 1, localUnique: 0, deviceLocalUnique: 0, lastScan: 1 } };
+  const snapshot = JSON.stringify(h);
+  D.recordScan(h, D.computeYield([{ k: "phone", raw: 1, listings: [] }]));
+  assert.strictEqual(JSON.stringify(h), snapshot);
+});
+
+test("cost estimate: 8 runs x 48 items is about 19 US cents, labelled estimate only", () => {
+  assert.strictEqual(D.estimateCostUsd(384, 8), 0.1924);
+});
+
+test("summarizeHistory reports devices per run and flags proven-zero terms", () => {
+  let h = {};
+  for (let i = 0; i < 3; i++) h = D.recordScan(h, D.computeYield([{ k: "256gb", raw: 48, listings: [] }, { k: "cellphone", raw: 48, listings: [mk(i, true)] }]));
+  const s = D.summarizeHistory(h);
+  assert.strictEqual(s[0].k, "cellphone");
+  assert.strictEqual(s.find(r => r.k === "256gb").provenZero, true);
+});
